<form action="{{action}}" method="{{method}}">
    <div>
        <label for="make">Make:</label>
        <input type="text" id="make" name="make" value="{{#if guitar}}{{guitar.make}}{{/if}}" required>
    </div>
    <div>
        <label for="model">Model:</label>
        <input type="text" id="model" name="model" value="{{#if guitar}}{{guitar.model}}{{/if}}" required>
    </div>
    <button type="submit">{{#if guitar}} Update {{else}} Create {{/if}} Guitar</button>
</form>